# Exemplo de terraform.tfvars (ADR-0003, Secao 13.2).
# Copie para terraform.tfvars, na raiz da stack, e ajuste os valores.
# terraform.tfvars e gitignored (ver .gitignore: *.tfvars, exceto .example)
# — NAO commitar o arquivo real, especialmente apos preencher
# 'eks_cluster.endpoint_public_access_cidrs' com CIDRs reais da
# organizacao.
#
# Estrutura de variaveis agrupadas por dominio, conforme
# .claude/rules/terraform-naming-conventions.md (Secao 4).
#
# Ambiente unico "prd" — nao ha "environment" como variavel de input
# (fixo em locals.tf, mesmo padrao de 00-/01-).

aws_region   = "sa-east-1"
project_name = "eks"

# Filtros de tag usados para localizar a VPC/sub-redes ja provisionadas
# por 01-networking-stack-ai (ADR-0003 Secao 4/D4) — NAO um
# terraform_remote_state.
networking = {
  stack_name  = "01-networking-stack-ai"
  environment = "prd"
}

eks_cluster = {
  kubernetes_version = "1.34"

  # OBRIGATORIO, sem default: informe o(s) CIDR(s) reais de onde o
  # devops-engineer/CI acessara o endpoint publico da API do cluster
  # (ex.: IP publico do escritorio/VPN, faixa de egress do runner de CI).
  # NUNCA "0.0.0.0/0" — a validacao em variables.tf rejeita esse valor
  # (ADR-0003 Secao 4/D2). O placeholder abaixo e INVALIDO
  # deliberadamente (bloqueia o plan/apply ate ser substituido por um
  # CIDR real).
  endpoint_public_access_cidrs = ["AJUSTAR-cidr-real/32"]

  enabled_log_types  = ["api", "audit", "authenticator", "controllerManager", "scheduler"]
  log_retention_days = 90
}

eks_secrets_encryption = {
  kms_deletion_window_days = 30
}

eks_node_group = {
  instance_types  = ["t3.medium"]
  capacity_type   = "ON_DEMAND"
  ami_type        = "AL2023_x86_64_STANDARD"
  disk_size       = 20
  desired_size    = 2
  min_size        = 2
  max_size        = 3
  max_unavailable = 1
}

tags = {
  Owner      = "AJUSTAR-time-responsavel"
  CostCenter = "AJUSTAR-centro-de-custo"
}
